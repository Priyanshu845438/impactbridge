generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  NGO
  COMPANY
  DONOR
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  pan       String?
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
