generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  phone          String?
  password       String
  role           Role
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  auditLogs      AuditLog[]      @relation("UserToAuditLogs")
  companyProfile CompanyProfile?
  donorProfile   DonorProfile?
  ngoProfile     NGOProfile?
  invitations    Invitation[]    @relation("UserInvitations")
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  role      Role
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  createdBy String

  creator User @relation("UserInvitations", fields: [createdBy], references: [id])
}

model NGOProfile {
  id                   String                @id @default(uuid())
  userId               String                @unique
  registrationType     NGORegistrationType
  registrationNumber   String
  founderNames         String
  yearEstablished      Int
  missionStatement     String
  impactSummary        String?
  website              String?
  twelveARegistered    Boolean               @default(false)
  eightyGRegistered    Boolean               @default(false)
  csrEligibility       Boolean               @default(false)
  deletedAt            DateTime?
  verificationStatus   String                @default("PENDING")
  verificationRemarks  String?
  addresses            Address[]             @relation("NGOAddresses")
  auditLogs            AuditLog[]            @relation("NGOAuditLogs")
  bankDetails          BankDetail[]          @relation("NGOBankDetails")
  campaigns            Campaign[]
  documents            Document[]            @relation("NGODocuments")
  financialReports     FinancialReport[]     @relation("NGOFinancialReports")
  approvals            CampaignApproval[]    @relation("NGOCampaignApprovals")
  programmeAssignments ProgrammeAssignment[]
  user                 User                  @relation(fields: [userId], references: [id])
}

model CompanyProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  cin                String              @unique
  csrPolicyUrl       String?
  industry           String
  netWorth           Float?
  averageProfit      Float?
  csrAnnualBudget    Float?
  csrAllocated       Float?
  csrSpent           Float?
  csrCommittee       String?
  deletedAt          DateTime?
  addresses          Address[]           @relation("CompanyAddresses")
  auditLogs          AuditLog[]          @relation("CompanyAuditLogs")
  bankDetails        BankDetail[]        @relation("CompanyBankDetails")
  user               User                @relation(fields: [userId], references: [id])
  documents          Document[]          @relation("CompanyDocuments")
  donations          Donation[]
  approvals          CampaignApproval[]  @relation("CompanyCampaignApprovals")
  utilizationReports UtilizationReport[]
  programmes         CSRProgramme[]
}

model DonorProfile {
  id         String     @id @default(uuid())
  userId     String     @unique
  pan        String?
  occupation String?
  interests  String?
  addresses  Address[]  @relation("DonorAddresses")
  auditLogs  AuditLog[] @relation("DonorAuditLogs")
  donations  Donation[]
  user       User       @relation(fields: [userId], references: [id])
}

model Campaign {
  id                 String              @id @default(uuid())
  ngoId              String
  title              String
  description        String
  category           CampaignCategory
  goalAmount         Float
  raisedAmount       Float               @default(0)
  startDate          DateTime
  endDate            DateTime?
  status             String
  deletedAt          DateTime?
  auditLogs          AuditLog[]          @relation("CampaignAuditLogs")
  ngo                NGOProfile          @relation(fields: [ngoId], references: [id])
  documents          Document[]          @relation("CampaignDocuments")
  donations          Donation[]
  milestones         Milestone[]
  approvals          CampaignApproval[]  @relation("CampaignApprovals")
  impactMetrics      ImpactMetric[]
  utilizationReports UtilizationReport[]
}

model Donation {
  id           String          @id @default(uuid())
  donorId      String?
  companyId    String?
  campaignId   String
  amount       Float
  donationDate DateTime        @default(now())
  paymentRef   String?
  paymentMode  String?
  receiptUrl   String?
  deletedAt    DateTime?
  auditLogs    AuditLog[]      @relation("DonationAuditLogs")
  campaign     Campaign        @relation(fields: [campaignId], references: [id])
  company      CompanyProfile? @relation(fields: [companyId], references: [id])
  donor        DonorProfile?   @relation(fields: [donorId], references: [id])
}

model BankDetail {
  id            String          @id @default(uuid())
  ngoId         String?
  companyId     String?
  accountHolder String
  bankName      String
  accountNumber String
  ifsc          String
  branch        String?
  company       CompanyProfile? @relation("CompanyBankDetails", fields: [companyId], references: [id])
  ngo           NGOProfile?     @relation("NGOBankDetails", fields: [ngoId], references: [id])
}

model Document {
  id         String          @id @default(uuid())
  ngoId      String?
  companyId  String?
  campaignId String?
  type       DocumentType
  title      String
  url        String
  uploadedAt DateTime        @default(now())
  metadata   Json?
  campaign   Campaign?       @relation("CampaignDocuments", fields: [campaignId], references: [id])
  company    CompanyProfile? @relation("CompanyDocuments", fields: [companyId], references: [id])
  ngo        NGOProfile?     @relation("NGODocuments", fields: [ngoId], references: [id])
}

model FinancialReport {
  id        String   @id @default(uuid())
  ngoId     String
  period    String
  year      Int
  reportUrl String
  createdAt DateTime @default(now())

  ngo NGOProfile @relation("NGOFinancialReports", fields: [ngoId], references: [id])
}

model NotificationIntent {
  id            String    @id @default(uuid())
  channel       String
  recipient     Json
  payload       Json
  status        String    @default("PENDING")
  retryCount    Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  metrics NotificationDeliveryMetric[]
}

model NotificationDeliveryMetric {
  id            String   @id @default(uuid())
  intentId      String
  provider      String
  outcome       String
  failureReason String?
  createdAt     DateTime @default(now())

  intent NotificationIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId])
}

model CampaignApproval {
  id         String   @id @default(uuid())
  campaignId String
  companyId  String
  ngoId      String
  status     String   @default("PENDING")
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign       @relation("CampaignApprovals", fields: [campaignId], references: [id])
  company  CompanyProfile @relation("CompanyCampaignApprovals", fields: [companyId], references: [id])
  ngo      NGOProfile     @relation("NGOCampaignApprovals", fields: [ngoId], references: [id])

  @@unique([campaignId, companyId])
}

model ImpactMetric {
  id          String   @id @default(uuid())
  campaignId  String
  milestoneId String?
  name        String
  value       Float
  unit        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign  Campaign   @relation(fields: [campaignId], references: [id])
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
}

model UtilizationReport {
  id          String   @id @default(uuid())
  campaignId  String
  milestoneId String?
  amountUsed  Float
  description String
  proofUrl    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String?

  campaign  Campaign        @relation(fields: [campaignId], references: [id])
  milestone Milestone?      @relation(fields: [milestoneId], references: [id])
  company   CompanyProfile? @relation(fields: [companyId], references: [id])
}

model Milestone {
  id              String   @id @default(uuid())
  campaignId      String
  title           String
  description     String
  targetDate      DateTime
  budget          Float
  status          String   @default("PENDING")
  progressPercent Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign           Campaign            @relation(fields: [campaignId], references: [id])
  impactMetrics      ImpactMetric[]
  utilizationReports UtilizationReport[]
}

model Address {
  id          String          @id @default(uuid())
  ngoId       String?
  companyId   String?
  donorId     String?
  line1       String
  line2       String?
  city        String
  state       String
  country     String          @default("India")
  postalCode  String
  addressType String?
  company     CompanyProfile? @relation("CompanyAddresses", fields: [companyId], references: [id])
  donor       DonorProfile?   @relation("DonorAddresses", fields: [donorId], references: [id])
  ngo         NGOProfile?     @relation("NGOAddresses", fields: [ngoId], references: [id])
}

model AuditLog {
  id         String          @id @default(uuid())
  userId     String?
  ngoId      String?
  companyId  String?
  donorId    String?
  campaignId String?
  donationId String?
  action     String
  details    Json?
  createdAt  DateTime        @default(now())
  campaign   Campaign?       @relation("CampaignAuditLogs", fields: [campaignId], references: [id])
  company    CompanyProfile? @relation("CompanyAuditLogs", fields: [companyId], references: [id])
  donation   Donation?       @relation("DonationAuditLogs", fields: [donationId], references: [id])
  donor      DonorProfile?   @relation("DonorAuditLogs", fields: [donorId], references: [id])
  ngo        NGOProfile?     @relation("NGOAuditLogs", fields: [ngoId], references: [id])
  user       User?           @relation("UserToAuditLogs", fields: [userId], references: [id])
}

model CSRProgramme {
  id          String          @id @default(uuid())
  companyId   String
  title       String
  description String?
  status      ProgrammeStatus @default(DRAFT)
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  company     CompanyProfile        @relation(fields: [companyId], references: [id])
  milestones  ProgrammeMilestone[]
  assignments ProgrammeAssignment[]
}

model ProgrammeMilestone {
  id          String                   @id @default(uuid())
  programmeId String
  title       String
  description String?
  dueDate     DateTime?
  status      ProgrammeMilestoneStatus @default(PENDING)
  progress    Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  programme CSRProgramme @relation(fields: [programmeId], references: [id])
}

model ProgrammeAssignment {
  id          String                    @id @default(uuid())
  programmeId String
  ngoId       String
  status      ProgrammeAssignmentStatus @default(INVITED)
  notes       String?
  assignedAt  DateTime                  @default(now())
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  programme CSRProgramme @relation(fields: [programmeId], references: [id])
  ngo       NGOProfile   @relation(fields: [ngoId], references: [id])

  @@unique([programmeId, ngoId])
}

enum Role {
  SUPER_ADMIN
  NGO
  COMPANY
  DONOR
  REVIEWER
  AUDITOR
}

enum NGORegistrationType {
  SOCIETY
  TRUST
  SECTION_8
  COOPERATIVE
  OTHER
}

enum DocumentType {
  CSR_POLICY
  REGISTRATION_CERTIFICATE
  PAN
  TAN
  BANK_STATEMENT
  AUDITED_FINANCIAL
  CSR_REPORT
  OTHER
}

enum CampaignCategory {
  EDUCATION
  HEALTHCARE
  ENVIRONMENT
  LIVELIHOOD
  WOMEN_EMPOWERMENT
  DISASTER_RELIEF
  OTHER
}

enum ProgrammeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgrammeMilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ProgrammeAssignmentStatus {
  INVITED
  ACTIVE
  REJECTED
  COMPLETED
}

model SystemSetting {
  key         String   @id
  value       String
  category    String   @default("PLATFORM")
  isSecret    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}
