{
  "info": {
    "_postman_id": "impactbridge-backend-collection",
    "name": "ImpactBridge Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Minimal Postman collection for ImpactBridge API v1"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"SUPER_ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Get Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Approvals",
      "item": [
        {
          "name": "List Pending Approvals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/approvals/company/{companyId}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "approvals",
                "company",
                "{companyId}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Donation Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "donations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Financial",
      "item": [
        {
          "name": "Upload NGO Report (409 on duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"period\": \"Q1\",\n  \"year\": 2024,\n  \"reportUrl\": \"https://cdn.example.com/report.pdf\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/financial/ngo/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "financial",
                "ngo",
                "upload"
              ]
            },
            "description": "Uploads a financial report for the authenticated NGO. Returns 409 Conflict when the period/year already exists."
          }
        },
        {
          "name": "List My NGO Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/financial/ngo/my-reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "financial",
                "ngo",
                "my-reports"
              ]
            },
            "description": "Lists reports for the current NGO user."
          }
        },
        {
          "name": "Admin \u2013 List NGO Reports",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/financial/admin/ngo/{{ngoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "financial",
                "admin",
                "ngo",
                "{{ngoId}}"
              ]
            },
            "description": "SUPER_ADMIN only. Lists reports for the specified NGO."
          }
        }
      ]
    },
    {
      "name": "CSR Programmes",
      "item": [
        {
          "name": "List Company Programmes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes"
              ]
            }
          }
        },
        {
          "name": "Get Programme Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes/{{programmeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes",
                "{{programmeId}}"
              ]
            }
          }
        },
        {
          "name": "Create Programme",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Water Access\",\n  \"description\": \"Provide safe drinking water\",\n  \"status\": \"ACTIVE\",\n  \"budget\": 100000,\n  \"startDate\": \"2025-03-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes"
              ]
            }
          }
        },
        {
          "name": "Update Programme",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes/{{programmeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes",
                "{{programmeId}}"
              ]
            }
          }
        },
        {
          "name": "Assign NGO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ngoId\": \"{{ngoId}}\",\n  \"notes\": \"Strategic partner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes/{{programmeId}}/assign-ngo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes",
                "{{programmeId}}",
                "assign-ngo"
              ]
            }
          }
        },
        {
          "name": "Transition Programme Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/companies/{{companyId}}/csr-programmes/{{programmeId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies",
                "{{companyId}}",
                "csr-programmes",
                "{{programmeId}}",
                "status"
              ]
            }
          }
        }
      ]
    }
  ]
}