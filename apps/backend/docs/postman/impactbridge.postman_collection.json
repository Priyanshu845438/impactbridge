          "name": "List NGOs (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of sanitized records', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(Array.isArray(json)).to.be.true;",
                  "  if (json.length) {",
                  "    pm.expect(json[0]).to.not.have.property('password');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/admin/ngos?page={{page}}&limit={{limit}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "admin",
                "ngos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            }
          }
        },
