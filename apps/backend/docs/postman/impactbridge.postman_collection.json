{
  "info": {
    "name": "ImpactBridge Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Auth, self-service, NGO compliance, and admin endpoints for ImpactBridge."
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:3000"},
    {"key": "token", "value": ""},
    {"key": "ngoId", "value": ""},
    {"key": "companyId", "value": ""},
    {"key": "donorId", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Admin\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"SUPER_ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('token', json.accessToken);",
                  "if (json.user && json.user.id) pm.collectionVariables.set('userId', json.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "NGO Self-Service",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"]}
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+911234567890\",\n  \"address\": \"HQ Road\"\n}"
            },
            "url": {"raw": "{{base_url}}/users/me", "host": ["{{base_url}}"], "path": ["users", "me"]}
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"password123\",\n  \"newPassword\": \"newSecret456\"\n}"
            },
            "url": {"raw": "{{base_url}}/users/change-password", "host": ["{{base_url}}"], "path": ["users", "change-password"]}
          }
        },
        {
          "name": "Update Registered Address",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"line1\": \"123 Trust Lane\",\n  \"district\": \"Bengaluru Urban\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\",\n  \"country\": \"India\"\n}"
            },
            "url": {"raw": "{{base_url}}/address/ngo", "host": ["{{base_url}}"], "path": ["address", "ngo"]}
          }
        },
        {
          "name": "Update Bank Details",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolder\": \"ImpactBridge NGO\",\n  \"accountNumber\": \"123456789012\",\n  \"ifscCode\": \"HDFC0001234\",\n  \"bankName\": \"HDFC Bank\",\n  \"branchName\": \"MG Road\"\n}"
            },
            "url": {"raw": "{{base_url}}/bank/ngo", "host": ["{{base_url}}"], "path": ["bank", "ngo"]}
          }
        }
      ]
    },
    {
      "name": "Admin Insights",
      "item": [
        {
          "name": "NGOs With Campaigns (SUPER_ADMIN/COMPANY)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/ngos-with-campaigns", "host": ["{{base_url}}"], "path": ["users", "ngos-with-campaigns"]}
          }
        },
        {
          "name": "Companies With Reports (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/companies-with-reports", "host": ["{{base_url}}"], "path": ["users", "companies-with-reports"]}
          }
        },
        {
          "name": "Admin NGO Profiles (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/admin/ngos", "host": ["{{base_url}}"], "path": ["users", "admin", "ngos"]}
          }
        },
        {
          "name": "Admin Company Profiles (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/admin/companies", "host": ["{{base_url}}"], "path": ["users", "admin", "companies"]}
          }
        },
        {
          "name": "Admin Donor Profiles (SUPER_ADMIN)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{base_url}}/users/admin/donors", "host": ["{{base_url}}"], "path": ["users", "admin", "donors"]}
          }
        }
      ]
    },
    {
      "name": "Legacy Users (To Sunset)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"]}
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": {"raw": "{{base_url}}/users/{{userId}}", "host": ["{{base_url}}"], "path": ["users", "{{userId}}"]}
          }
        }
      ]
    }
  ]
}
